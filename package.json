{
  "name": "zenc",
  "displayName": "Zen C",
  "description": "Language support for Zen C",
  "version": "0.0.3",
  "publisher": "z-libs",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenc-lang/vscode-zenc"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zenc",
        "aliases": [
          "Zen C",
          "zenc"
        ],
        "extensions": [
          ".zc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "zenc"
      }
    ],
    "grammars": [
      {
        "language": "zenc",
        "scopeName": "source.zenc",
        "path": "./syntaxes/zenc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zenc.showServerOutput",
        "title": "Show Language Server Output",
        "category": "Zen C"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Zen C",
      "properties": {
        "zenc.serverPath": {
          "type": [
            "string",
            "null"
          ],
          "default": "zc",
          "description": "Path to the Zen C compiler executable (zc)"
        },
        "zenc.server.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Start the language server with --verbose, so it logs what it does to the \"Zen C Language Server\" output. Takes effect when the server starts."
        },
        "zenc.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages between VS Code and the language server in the \"Zen C Language Server\" output."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.19.0",
    "esbuild": "^0.27.2",
    "ovsx": "^0.9.1",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}